---
layout: base.njk
permalink: services.html
mainJs: true
jsonLd: services
footer: hours
eleventyComputed:
  title: "Services & Prices — {{ site.name }}"
description: "Gauge installs from $700, wideband AFR & EGT from $250, shift lights from $200, supply and install. Sound systems and auto electrical repairs."
---
    <!-- 1. Page header -->
    <div class="container page-head">
      <h1 class="page-title">Services</h1>
      <p class="page-intro">Here's what we do. Prices are a starting point — we confirm everything in your quote.</p>
    </div>

    <!-- 2. Service cards (content comes from src/_data/services.json) -->
    <div class="container service-list">
      {%- for service in services %}
      <section class="service" id="{{ service.id }}" aria-labelledby="{{ service.id }}-title">
        <div class="service-intro">
          <div class="icon-tile tile-{{ service.tile }}" aria-hidden="true">
            {% include "icons/" + service.id + ".svg" %}
          </div>
          <h2 id="{{ service.id }}-title">{{ service.title }}</h2>
          <p>{{ service.subtitle }}</p>
        </div>
        <ul class="price-list">
          {%- for item in service.items %}
          {#- Real prices are bold white; "quote" and unfilled [PRICE] are muted. #}
          {%- set tbc = item.price == "quote" or "[" in item.price %}
          <li><span class="svc-name">{{ item.name }}{% if item.note %} <span class="svc-note">{{ item.note }}</span>{% endif %}</span><span class="{{ 'price-tbc' if tbc else 'price' }}">{{ item.price }}</span></li>
          {%- endfor %}
        </ul>
      </section>
      {%- endfor %}
    </div>

    <!-- 3. Quote form -->
    <section id="quote" class="section-alt border-top" aria-labelledby="quote-title">
      <div class="quote-inner">
        <div class="quote-head">
          <h2 id="quote-title">Get a quote</h2>
          <p>Or call us on <a class="text-link" href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>.</p>
        </div>

        <!--
          Sent by Formspree (formId in src/_data/site.json). With JavaScript on,
          js/main.js submits in the background and then opens thanks.html. Without
          it, the visitor sees Formspree's own thank-you page. _gotcha is the honeypot.
        -->
        <form class="quote-form" name="quote" method="POST" action="https://formspree.io/f/{{ site.formId }}" aria-label="Quote request" data-quote-form>
          <div class="visually-hidden" aria-hidden="true">
            <label for="q-bot">Leave this field empty</label>
            <input id="q-bot" type="text" name="_gotcha" tabindex="-1" autocomplete="off">
          </div>

          <div class="form-row">
            <div class="field">
              <label for="q-name">Name</label>
              <input id="q-name" type="text" name="name" required autocomplete="name">
            </div>
            <div class="field">
              <label for="q-contact">Phone or email</label>
              <input id="q-contact" type="text" name="contact" required>
            </div>
          </div>

          <div class="field">
            <label for="q-car">Your car</label>
            <input id="q-car" type="text" name="car" placeholder="Year, make, model">
          </div>

          <div class="field">
            <label for="q-message">What would you like done?</label>
            <textarea id="q-message" name="message" rows="5" required></textarea>
          </div>

          <button class="btn btn-primary btn-submit" type="submit">Send request</button>
        </form>
      </div>
    </section>
