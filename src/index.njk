---
layout: base.njk
permalink: index.html
noJsClass: true
mainJs: true
jsonLd: true
eleventyComputed:
  title: "{{ site.name }} — Gauges, Sensors & Car Audio in {{ site.town }}"
  description: "Performance gauge and sensor installs, sound systems and auto electrical repairs in {{ site.town }}. Get a quote today."
---
    <!-- 1. Hero -->
    <section aria-labelledby="hero-title">
      <div class="container hero">
        <span class="pill">Gauges · Sensors · Sound systems</span>
        <h1 id="hero-title">Auto electrical for people who love their cars.</h1>
        <p class="lead">Performance gauge and sensor installs, sound system upgrades and everyday auto electrical repairs — done neatly and explained clearly.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="services.html#quote">Get a quote</a>
          <a class="btn btn-secondary" href="services.html">See services</a>
        </div>
      </div>
    </section>

    <!-- 2. What we do -->
    <section class="section-alt border-top border-bottom" aria-labelledby="what-title">
      <div class="container features">
        <h2 id="what-title">What we do</h2>
        <div class="feature-grid">
          <div class="feature">
            <div class="icon-tile tile-red" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.9 19a9 9 0 1 1 14.2 0"/><path d="M12 13l4-5"/></svg>
            </div>
            <h3>Performance</h3>
            <p>Boost, AFR, EGT and oil gauges, shift lights, digital dashes and data logging.</p>
          </div>
          <div class="feature">
            <div class="icon-tile tile-yellow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="#1A1A1A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>
            </div>
            <h3>Sound systems</h3>
            <p>Head units, speakers, amps and subs, DSP tuning and sound deadening.</p>
          </div>
          <div class="feature">
            <div class="icon-tile tile-white" aria-hidden="true">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z" fill="#D32F2F"/></svg>
            </div>
            <h3>Auto electrical</h3>
            <p>Diagnostics, wiring repairs, batteries, alternators, lighting and accessories.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Recent work slideshow (cards come from src/_data/jobs.json) -->
    <section aria-labelledby="work-title" data-carousel>
      <div class="container work">
        <div class="work-head">
          <div class="work-title">
            <p class="eyebrow">Recent work</p>
            <h2 id="work-title">Jobs we've done</h2>
          </div>
          <div class="work-controls">
            <p class="work-counter" aria-live="polite">1 / {{ jobs.length }}</p>
            <button class="round-btn round-btn-prev" type="button" aria-label="Previous job" data-prev>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <button class="round-btn round-btn-next" type="button" aria-label="Next job" data-next>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          </div>
        </div>

        <div class="work-viewport" role="region" aria-roledescription="carousel" aria-label="Recent jobs">
          <div class="work-track">
            {%- for job in jobs %}
            <article class="job job--{{ job.type }}">
              {%- if job.photo %}
              <div class="job-photo">
                <img src="img/work/{{ job.photo }}" alt="{{ job.photoAlt }}" width="680" height="440" loading="lazy">
              </div>
              {%- else %}
              <div class="job-photo" role="img" aria-label="Photo placeholder for {{ job.title }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                <span>[YOUR PHOTO]</span>
              </div>
              {%- endif %}
              <div class="job-body">
                <p class="job-tag">{{ job.tag }}</p>
                <h3>{{ job.title }}</h3>
                <p class="job-vehicle">{{ job.vehicle }}</p>
                <p class="job-desc">{{ job.description }}</p>
              </div>
            </article>
            {%- endfor %}
          </div>
        </div>

        <div class="work-dots"></div>
      </div>
    </section>

    <!-- 4. Why us -->
    <section class="section-alt border-top" aria-labelledby="why-title">
      <div class="container why">
        <h2 id="why-title">Neat work, clear quotes, no surprises.</h2>
        <ul>
          {%- for point in [
            "Wiring hidden, loomed and properly connected",
            "Parts recommended to suit your car and budget",
            "Itemised quote before any work starts",
            "Everything tested and explained at pick-up"
          ] %}
          <li><svg viewBox="0 0 24 24" fill="none" stroke="#FFC93C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 5 5 9-10"/></svg>{{ point }}</li>
          {%- endfor %}
        </ul>
      </div>
    </section>

    <!-- 5. Ready to book in -->
    <section class="section-alt" aria-labelledby="cta-title">
      <div class="container cta-wrap">
        <div class="cta-panel">
          <div class="cta-text">
            <h2 id="cta-title">Ready to book in?</h2>
            <p>Call {{ site.phone }} or send a quick quote request.</p>
          </div>
          <a class="btn btn-cta" href="services.html#quote">Get a quote</a>
        </div>
      </div>
    </section>
